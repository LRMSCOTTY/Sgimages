# ============================================================
# AI Video Creator Platform — Environment Variables
# Copy to .env and fill in your values
# On Railway: set these in the Railway dashboard under Variables
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# ---- Auth (REQUIRED for user accounts) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ---- Admin Dashboard ----
# Set this to YOUR email. Only this address can access the admin dashboard.
# In dev mode (no DATABASE_URL), everyone is admin automatically.
ADMIN_EMAIL=you@example.com

# ---- Database (REQUIRED for user accounts) ----
# Railway: add a PostgreSQL plugin — DATABASE_URL is set automatically
DATABASE_URL=postgresql://user:password@localhost:5432/sgimages
# Set to "1" when the DB requires TLS/SSL (Railway PostgreSQL does)
DATABASE_SSL=1

# Storage (local dir for generated videos)
STORAGE_DIR=./public/videos
MAX_VIDEO_AGE_HOURS=24

# ---- Open-Source AI (via Replicate — RECOMMENDED) ----
# LTX-Video, HunyuanVideo, Mochi-1, Wan 2.1, CogVideoX
# Get your key at https://replicate.com/account/api-tokens (~$0.03-0.10/video)
REPLICATE_API_TOKEN=r8_your_token_here

# ---- Commercial AI Providers (optional, add what you have) ----

# Runway Gen-3 Alpha / Turbo  https://app.runwayml.com
RUNWAYML_API_SECRET=

# Luma AI Dream Machine  https://lumalabs.ai/dream-machine/api/keys
LUMAAI_API_KEY=

# Kling AI  https://platform.klingai.com
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Hailuo / MiniMax  https://hailuoai.com
HAILUO_API_KEY=

# ---- AI Director (uses Claude for shot planning) ----
ANTHROPIC_API_KEY=

# ---- Rate Limiting ----
MAX_CONCURRENT_JOBS=3
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ---- CORS (dev only — production uses same-origin) ----
CORS_ORIGIN=http://localhost:5173
