# ============================================================
# AI Video Creator Platform — Environment Variables
# Copy to .env and fill in your API keys
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Storage (local dir for generated videos)
STORAGE_DIR=./public/videos
MAX_VIDEO_AGE_HOURS=24

# ---- AI Video Providers (add the ones you have) ----

# Runway Gen-3 Alpha / Turbo  https://runwayml.com
RUNWAY_API_KEY=

# Replicate (SVD, CogVideoX, Wan2.1, Zero123+)  https://replicate.com
REPLICATE_API_TOKEN=

# Luma AI Dream Machine  https://lumalabs.ai
LUMA_API_KEY=

# Kling AI  https://kling.ai
KLING_API_KEY=
KLING_API_SECRET=

# Hailuo / MiniMax  https://hailuoai.com
HAILUO_API_KEY=

# ---- AI Director (uses Claude for shot planning) ----
ANTHROPIC_API_KEY=

# ---- Rate Limiting ----
MAX_CONCURRENT_JOBS=3
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173
